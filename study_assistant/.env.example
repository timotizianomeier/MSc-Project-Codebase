# Optional realtime input transcription language.
# Defaults to "en". Set to a backend-supported code such as "zh" for Chinese.
# REALTIME_TRANSCRIPTION_LANGUAGE="en"

# Hugging Face connection mode: "deployed" or "local".
# Deployed mode uses the built-in Hugging Face server.
# Defaults to "deployed" when unset.
# HF_REALTIME_CONNECTION_MODE="deployed"

# Direct Hugging Face realtime endpoint for local/LAN backends.
# Accepts either the base URL (`ws://127.0.0.1:8765/v1`) or the full realtime URL
# (`ws://127.0.0.1:8765/v1/realtime`). Used when HF_REALTIME_CONNECTION_MODE=local.
# HF_REALTIME_WS_URL="ws://127.0.0.1:8765/v1/realtime"

# Hugging Face token for accessing datasets/models
HF_TOKEN=

# Optional built-in profile selector. Use a folder name from profiles/.
# If unset, the app uses the default profile unless startup settings were saved from the UI.
# REACHY_MINI_CUSTOM_PROFILE=mars_rover

# Optional external profile/tool directories
# REACHY_MINI_EXTERNAL_PROFILES_DIRECTORY=external_content/external_profiles
# REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY=external_content/external_tools

# Optional: discover and auto-load all tools found in REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY,
# even if they are not listed in the selected profile's tools.txt.
# This is convenient for downloaded tools used with built-in/default profiles.
# AUTOLOAD_EXTERNAL_TOOLS=1

# Minutes of inactivity before Reachy goes to sleep and the app stops. Default 1440 (one day), 0 disables.
# REACHY_MINI_APP_TIMEOUT_MINUTES=1440

# Engagement-scoring service endpoint (separate process; see the engagement_detector repo).
# Used when the app runs with --engagement. Defaults to the local service.
# ENGAGEMENT_SERVICE_URL="http://127.0.0.1:8100"

# Face-detector backend for emotion recognition (deepface). Default "opencv" (fast haar cascade);
# "retinaface" and "mtcnn" are slower but far more robust to pose/angle.
# EMOTION_DETECTOR_BACKEND="opencv"

# Emotion-classifier backend. Default "emotiefflib" (AffectNet-trained EfficientNet via ONNX,
# the study standard on all platforms); "deepface" (FER-2013 CNN) retained for detector A/B,
# requires the emotion-deepface/emotion-all extra. EMOTION_DETECTOR_BACKEND applies to the
# deepface path only; emotiefflib always uses haar.
# EMOTION_CLASSIFIER_BACKEND="emotiefflib"

# Windowed negative-mass threshold for emotion interventions. Backend-dependent calibration:
# 0.40 matches the historical label-counting gate under deepface's near-one-hot outputs
# and stays the code default. emotiefflib's softer distributions need more headroom:
# neutral working faces ran 0.35-0.73 negative_share live (02-03.08) → study value 0.55.
# EMOTION_NEGATIVE_THRESHOLD="0.55"

# When set, every emotion-analyzed frame is saved there as <HHMMSS>_<label>.jpg for post-hoc
# analysis (detector A/B, study recordings). Empty/unset disables the dump.
# EMOTION_FRAME_DUMP_DIR="logs/frames/session-label"

# Full-session A/V recording. When set, each run writes a
# timestamped folder there with user_audio.wav + robot_audio.wav (mono int16, separate tracks)
# and frames/ (engagement-cadence camera JPEGs, 2 fps — requires camera + engagement enabled).
# Empty/unset disables recording. ~0.5-1 GB per 2 h session.
# SESSION_RECORDING_DIR="logs/recordings"

# Study control condition (equivalent to the --control CLI flag, which is the usual way to
# set it). Sensing and recording run normally; every robot output is gated and interventions
# are logged as counterfactuals. Not re-read on settings refresh — the condition cannot flip
# mid-session.
# CONTROL_MODE=1

# Baseline head-pitch trim in degrees, applied to every pose sent to the robot — aims the
# resting head/camera at the participant's face without per-session manual positioning.
# NEGATIVE tilts the head UP. 0/unset = stock posture.
# HEAD_PITCH_TRIM_DEG="-8"

# Idle antenna heartbeat ("body double" cue): a subtle antenna variation (5 kinds, random) every 10-30s
# while the robot is otherwise fully idle. The head (and camera) never move. Suppressed in
# the control condition regardless of this setting. Default off.
# ANTENNA_HEARTBEAT_ENABLED=1

# Silence prepended before each robot utterance so the audio output pipeline is open
# before the first word arrives (fixes clipped first words; the robot's own pipeline
# reports ~290ms min latency, so the physical unit may want more than the sim).
# Milliseconds; 0 disables. Default 200.
# SPEECH_PREROLL_MS="200"

# Playback-rate factor for robot speech: 0.95 plays 5% slower (pitch drops ~0.9
# semitones — subtle below ~5%). Qwen3-TTS has no native speed control, so pace is
# adjusted at playback. Default 1.0 = stock pace.
# SPEECH_RATE="1.0"

# Windowed-average engagement threshold: re-engagement fires when the 30s average
# falls BELOW this. Default 0.93 (Lalwani et al.). Live calibration bands (07/2026):
# real participant at robot camera 0.85-0.94; straight-head robot camera 0.73-0.84;
# head-down-at-laptop webcam 0.65-0.73 → study value ~0.80.
# ENGAGEMENT_THRESHOLD="0.93"

# Study session gate: when on, the app starts armed-but-dormant (no greeting, no
# emotion/engagement monitoring, no mic or context input) until the participant presses
# "Start session" on /participant; a timer then ends the session after
# SESSION_DURATION_MINUTES (robot announces the end; suppressed in the control condition).
# SESSION START / SESSION END log banners delimit the analysis window — recording itself
# runs for the whole script. Default off = stock behavior.
# SESSION_GATE_ENABLED=1
# SESSION_DURATION_MINUTES="25"

# Unprompted-motion knobs, DEFAULT OFF (study-first: minimize distraction during focused work
# + keep the head camera still for stable frames). Set to 1 to restore stock idle behaviors:
# IDLE_MOTIONS_ENABLED re-enables the random idle tools (emotes/head moves after ~3 min quiet);
# BREATHING_ENABLED re-enables the idle breathing micro-motion. Speech-driven motion is always on.
# IDLE_MOTIONS_ENABLED=0
# BREATHING_ENABLED=0
